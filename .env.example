# Copie este archivo como .env y ajuste los valores. NO suba .env al repositorio.
# Ambiente a ejecutar: local | rc | example  (ver config/environments/*.json)
TEST_ENV=local
# Opcional: sobreescribe la baseURL del perfil (obligatorio para TEST_ENV=example)
BASE_URL=
# Puerto del servidor local de la app
APP_PORT=4173
# Opciones de ejecución
HEADLESS=true
WORKERS=
RETRIES=0
# Activa SOLO la ejecución de demostración con fallo controlado (no usar en la suite normal)
DEMO_FAILURE=0
# La aplicación no tiene autenticación; si el ambiente la tuviera, las credenciales irían aquí:
# APP_USER=usuario.demo@example.com
# APP_PASSWORD=cambie-esto
